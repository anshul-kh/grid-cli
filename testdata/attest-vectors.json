{
  "schema": "grid-attest-vectors-v1",
  "canonical": [
    {
      "name": "flat-object-keys-sorted",
      "input": {
        "b": 1,
        "a": 2,
        "c": 3
      },
      "expected": "{\"a\":2,\"b\":1,\"c\":3}"
    },
    {
      "name": "nested-objects-and-arrays",
      "input": {
        "z": {
          "y": [
            3,
            1,
            2
          ],
          "x": null
        },
        "a": true
      },
      "expected": "{\"a\":true,\"z\":{\"x\":null,\"y\":[3,1,2]}}"
    },
    {
      "name": "empty-containers",
      "input": {
        "obj": {},
        "arr": []
      },
      "expected": "{\"arr\":[],\"obj\":{}}"
    },
    {
      "name": "unicode",
      "input": {
        "k": "héllo → 世界 🙂"
      },
      "expected": "{\"k\":\"héllo → 世界 🙂\"}"
    },
    {
      "name": "control-chars",
      "input": {
        "k": "a\nb\tc\bd\u0001e"
      },
      "expected": "{\"k\":\"a\\nb\\tc\\bd\\u0001e\"}"
    },
    {
      "name": "no-html-escaping",
      "input": {
        "k": "\u003cscript\u003e\u0026\u003c/script\u003e"
      },
      "expected": "{\"k\":\"\u003cscript\u003e\u0026\u003c/script\u003e\"}"
    },
    {
      "name": "float-shortest-roundtrip",
      "input": {
        "a": 1e-7,
        "b": 1e21,
        "c": 1014.6,
        "d": 1e-6
      },
      "expected": "{\"a\":1e-7,\"b\":1e+21,\"c\":1014.6,\"d\":0.000001}"
    },
    {
      "name": "integer-boundaries",
      "input": {
        "zero": 0,
        "max": 9007199254740992,
        "neg": -42
      },
      "expected": "{\"max\":9007199254740992,\"neg\":-42,\"zero\":0}"
    },
    {
      "name": "negative-zero",
      "input": {
        "k": -0.0
      },
      "expected": "{\"k\":0}"
    },
    {
      "name": "bools-and-null",
      "input": {
        "t": true,
        "f": false,
        "n": null
      },
      "expected": "{\"f\":false,\"n\":null,\"t\":true}"
    },
    {
      "name": "u2028-u2029-not-escaped",
      "input": {
        "k": "a\u2028b\u2029c"
      },
      "expected": "{\"k\":\"a\u2028b\u2029c\"}"
    },
    {
      "name": "deep-nested",
      "input": {
        "a": {
          "b": {
            "c": [
              {
                "d": 1
              }
            ]
          }
        }
      },
      "expected": "{\"a\":{\"b\":{\"c\":[{\"d\":1}]}}}"
    },
    {
      "name": "array-order-preserved",
      "input": [
        3,
        1,
        2,
        "x",
        null,
        true
      ],
      "expected": "[3,1,2,\"x\",null,true]"
    },
    {
      "name": "string-escapes",
      "input": {
        "k": "quote\" back\\ slash"
      },
      "expected": "{\"k\":\"quote\\\" back\\\\ slash\"}"
    },
    {
      "name": "scalar-root",
      "input": "hello",
      "expected": "\"hello\""
    }
  ],
